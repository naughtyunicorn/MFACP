# Database
DATABASE_URL="postgresql://user:password@localhost:5432/mfa_platform"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# WebAuthn Configuration
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_ORIGIN="http://localhost:3000"
WEBAUTHN_RP_NAME="MFA Card Platform"

# Application URLs
WEB_URL="http://localhost:3000"
API_URL="http://localhost:3001"

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET="your-session-secret-change-in-production"

# Risk Engine
RISK_THRESHOLD_HIGH=80
RISK_THRESHOLD_MEDIUM=60
MAX_FAILED_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Recovery
RECOVERY_CODE_COUNT=10
RECOVERY_CODE_LENGTH=8
RECOVERY_SESSION_DURATION_MINUTES=30

# NFC Card Configuration
CARD_AID="F000000001"
CARD_CHALLENGE_TIMEOUT_SECONDS=60

# Email (for notifications)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
FROM_EMAIL="noreply@mfacard.com"

# Development
NODE_ENV="development"
LOG_LEVEL="debug"
