# Production Environment Variables
NODE_ENV=production

# Database Configuration
DATABASE_URL=postgresql://username:password@prod-host:5432/mfa_platform

# Redis Configuration
REDIS_URL=redis://prod-redis:6379

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-change-this-in-production

# WebAuthn Configuration
WEBAUTHN_RP_NAME=MFA Card Platform
WEBAUTHN_RP_ID=mfa-card-platform.vercel.app
WEBAUTHN_ORIGIN=https://mfa-card-platform.vercel.app

# Application Configuration
API_PORT=3015
API_HOST=0.0.0.0

# Security Configuration
CORS_ORIGIN=https://mfa-card-platform.vercel.app
SESSION_SECRET=your-super-secure-session-secret-change-this-in-production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
